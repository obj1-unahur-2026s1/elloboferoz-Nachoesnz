import Semana-3-Wollok.elloboferoz-Nachoesnz.canastaManzanas.*
import Semana-3-Wollok.elloboferoz-Nachoesnz.manzana.*
object caperucita {
    var pesoCaperucita = 60

    method pesoTotalCaperucita(){
        pesoCaperucita = pesoCaperucita + canastaManzanas.pesoCanasta()
        return pesoCaperucita
    }




}